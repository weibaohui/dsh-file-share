{
  "name": "@weibaohui/dsh-file-share",
  "version": "0.2.1",
  "description": "dsh 插件 · 会话工作区文件管理：在对话区加「文件」tab，浏览当前会话工作区的目录树并就地管理（上传/下载/新建文件夹/改名/删除/搜索），文件可 @ 进对话框给 agent 处理。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-file-share.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-file-share#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-file-share/issues"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/share-core.js && node --check client/index.js",
    "test": "node --test \"test/*.test.js\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh",
    "file",
    "files",
    "workspace",
    "file-manager",
    "upload",
    "download",
    "@file"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=20"
  }
}
